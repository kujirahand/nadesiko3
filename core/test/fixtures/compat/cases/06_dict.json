      "vars": [
        "A"
      ]
    },
    {
      "name": "辞書-存在しないキー",
      "code": "A={\"x\":1}\nA[\"none\"]を表示",
      "vars": [
        "A"
      ]
    },
    {
      "name": "辞書キー列挙",
