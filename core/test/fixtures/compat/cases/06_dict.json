        "A"
      ]
    },
    {
      "name": "辞書-入れ子",
      "code": "A={\"p\":{\"q\":7}}\nA[\"p\"][\"q\"]を表示",
      "vars": [
        "A"
      ]
    },
    {
      "name": "辞書-配列を値に持つ",
      "code": "A={\"list\":[1,2,3]}\nA[\"list\"][2]を表示",
      "vars": [
        "A"
      ]
    },
    {
      "name": "JSONエンコード",
      "code": "(({\"x\":1,\"y\":[1,2]})をJSONエンコード)を表示",
