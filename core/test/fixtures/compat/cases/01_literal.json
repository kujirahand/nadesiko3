{
  "group": "01_literal",
  "description": "リテラルと基本的な表示。数値・文字列・真偽値・特殊値の観測可能な表現を固定する。",
  "cases": [
    { "name": "整数", "code": "3を表示", "vars": [] },
    { "name": "整数-大きい値", "code": "1234567890を表示", "vars": [] },
    { "name": "実数", "code": "3.14を表示", "vars": [] },
    { "name": "実数-末尾ゼロ", "code": "3.10を表示", "vars": [] },
    { "name": "負数", "code": "-5を表示", "vars": [] },
    { "name": "16進数", "code": "0xFFを表示", "vars": [] },
    { "name": "8進数", "code": "0o17を表示", "vars": [] },
    { "name": "2進数", "code": "0b1010を表示", "vars": [] },
    { "name": "指数表記", "code": "1e3を表示", "vars": [] },
    { "name": "数値区切り", "code": "1_000を表示", "vars": [] },
    { "name": "文字列-鍵括弧", "code": "「abc」を表示", "vars": [] },
    { "name": "文字列-二重引用符", "code": "\"abc\"を表示", "vars": [] },
    { "name": "文字列-全角二重引用符", "code": "“あいう”を表示", "vars": [] },
    { "name": "文字列-二重鍵括弧は展開しない", "code": "『abc{30}abc』を表示", "vars": [] },
    { "name": "文字列-単引用符は展開しない", "code": "'abc{30}'を表示", "vars": [] },
    { "name": "文字列展開-変数", "code": "A=30\n「abc{A}abc」を表示", "vars": ["A"] },
    { "name": "文字列展開-全角波括弧", "code": "A=30\n「abc｛A｝abc」を表示", "vars": ["A"] },
    { "name": "文字列展開-式", "code": "A=30\n「{A+1}」を表示", "vars": ["A"] },
    { "name": "文字列展開-命令呼び出し", "code": "A=30\n「{Aに2を掛ける}」を表示", "vars": ["A"] },
    { "name": "文字列展開-入れ子の括弧", "code": "A=[1,2,3]\n「{A[1]}」を表示", "vars": ["A"] },
    { "name": "エスケープ-改行", "code": "「あ\\nい」を表示", "vars": [] },
    { "name": "エスケープ-タブ", "code": "「あ\\tい」を表示", "vars": [] },
    { "name": "定数-改行", "code": "「あ{改行}い」を表示", "vars": [] },
    { "name": "定数-タブ", "code": "「あ{タブ}い」を表示", "vars": [] },
    { "name": "真偽値-真", "code": "オンを表示", "vars": [] },
    { "name": "真偽値-偽", "code": "オフを表示", "vars": [] },
    { "name": "真偽値-はい", "code": "はいを表示", "vars": [] },
    { "name": "空", "code": "A=空\nAを表示", "vars": ["A"] },
    { "name": "未定義", "code": "A=未定義\nAを表示", "vars": ["A"] },
    { "name": "配列リテラル", "code": "A=[1,2,3]\nAを表示", "vars": ["A"] },
    { "name": "配列リテラル-入れ子", "code": "A=[[1,2],[3,4]]\nAを表示", "vars": ["A"] },
    { "name": "辞書リテラル", "code": "A={\"x\":1,\"y\":2}\nAを表示", "vars": ["A"] },
    { "name": "辞書リテラル-日本語キー", "code": "A={\"名前\":\"太郎\",\"年齢\":20}\nAを表示", "vars": ["A"] },
    { "name": "コメント-シャープ", "code": "# コメント\n1を表示", "vars": [] },
    { "name": "コメント-スラッシュ", "code": "// コメント\n1を表示", "vars": [] },
    { "name": "コメント-ブロック", "code": "/* コメント */\n1を表示", "vars": [] },
    { "name": "複数文-セミコロン", "code": "A=1;B=2;(A+B)を表示", "vars": ["A", "B"] },
    { "name": "表示-複数回の改行区切り", "code": "1を表示\n2を表示\n3を表示", "vars": [] }
  ]
}
