#-------------------------------------------------
# なでしこ3の命令一覧を検索するCLI (#2385)
#-------------------------------------------------
# 入力: doc/command_list.json
# 引数: 環境変数『NAKO3_SEARCH_ARGS』にJSON配列で指定する
# 起動: node batch/search_command.mjs (または npm run search:command)
#-------------------------------------------------

命令ファイル＝母艦パスを「../doc/command_list.json」で相対パス展開。

#-------------------------------------------------
# 引数の取得と解析
#-------------------------------------------------
# 環境変数から引数の配列を取得する
●コマンド引数取得()
    S＝「NAKO3_SEARCH_ARGS」の環境変数取得。
    もし、(Sの変数型確認)≠「string」ならば、[]で戻る。
    もし、S=「」ならば、[]で戻る。
    SをJSONデコード。
    それで戻る。
ここまで。

# 『--option=値』の形式を『--option』『値』の2つに分解する
●引数展開(ARGSを)
    R＝[]
    ARGSを反復
        A＝「{対象}」
        P＝0
        もし、Aが「--」で文字始ならば
            P＝Aで「=」が何文字目か。
        ここまで。
        もし、P>2ならば
            NCNT＝P-1
            VCNT＝(Aの文字数)-P
            RにAのNCNTだけ文字左部分を配列追加。
            RにAのVCNTだけ文字右部分を配列追加。
        違えば
            RにAを配列追加。
        ここまで。
    ここまで。
    Rで戻る。
ここまで。

# 引数の配列を解析して設定の辞書を返す
●引数解析(ARGSを)
    OPT＝空辞書。
    OPT['target']＝「」
    OPT['group']＝「」
    OPT['plugin']＝「」
    OPT['type']＝「」
    OPT['limit']＝「50」
    OPT['json']＝オフ。
    OPT['help']＝オフ。
    OPT['error']＝「」
    OPT['words']＝[]
    LIST＝ARGSを引数展開。
    N＝LISTの要素数。
    I＝0
    (I<N)の間、繰り返す
        A＝「{LIST[I]}」
        もし、Aが「--」で文字始ならば
            NCNT＝(Aの文字数)-2
            NAME＝AのNCNTだけ文字右部分。
            値必要＝オフ。
            もし、(NAME=「target」)または(NAME=「group」)または(NAME=「plugin」)または(NAME=「type」)または(NAME=「limit」)ならば
                値必要＝オン。
            ここまで。
            もし、値必要＝オンならば
                I＝I+1
                もし、I>=Nならば
                    OPT['error']＝「オプション『{A}』には値の指定が必要です。」
                違えば
                    OPT[NAME]＝「{LIST[I]}」
                ここまで。
            違えば
                もし、NAME=「help」ならば
                    OPT['help']＝オン。
                違えば
                    もし、NAME=「json」ならば
                        OPT['json']＝オン。
                    違えば
                        OPT['error']＝「不明なオプション『{A}』です。」
                    ここまで。
                ここまで。
            ここまで。
        違えば
            もし、A=「-h」ならば
                OPT['help']＝オン。
            違えば
                もし、(Aが「-」で文字始)かつ((Aの文字数)>1)ならば
                    OPT['error']＝「不明なオプション『{A}』です。」
                違えば
                    OPT['words']にAを配列追加。
                ここまで。
            ここまで。
        ここまで。
        I＝I+1
    ここまで。
    OPTで戻る。
ここまで。

# グループ名の指定を『基本プラグイン』『拡張プラグイン』に正規化する
●グループ正規化(Gの)
    G2＝Gを小文字変換。
    もし、(G2=「basic」)または(G=「基本」)または(G=「基本プラグイン」)ならば、「基本プラグイン」で戻る。
    もし、(G2=「extra」)または(G2=「extended」)または(G=「拡張」)または(G=「拡張プラグイン」)ならば、「拡張プラグイン」で戻る。
    「」で戻る。
ここまで。

# オプションの値が正しいかを調べてエラーメッセージを返す(問題なければ空文字)
●オプション検査(OPTを)
    T＝OPT['target']
    もし、T≠「」ならば
        TLIST＝「cnako,wnako,phpnako,enako」
        IDX＝「,{TLIST},」で「,{T},」が何文字目か。
        もし、IDX=0ならば
            「オプション『--target』には {TLIST} のいずれかを指定してください。指定値=『{T}』」で戻る。
        ここまで。
    ここまで。
    G＝OPT['group']
    もし、G≠「」ならば
        G2＝Gのグループ正規化。
        もし、G2=「」ならば
            「オプション『--group』には basic(基本プラグイン)またはextra(拡張プラグイン)を指定してください。指定値=『{G}』」で戻る。
        ここまで。
    ここまで。
    TY＝OPT['type']
    もし、TY≠「」ならば
        もし、(TY≠「関数」)かつ(TY≠「変数」)かつ(TY≠「定数」)ならば
            「オプション『--type』には 関数/変数/定数 のいずれかを指定してください。指定値=『{TY}』」で戻る。
        ここまで。
    ここまで。
    L＝OPT['limit']を整数変換。
    もし、(「{L}」=「NaN」)または(L<0)ならば
        「オプション『--limit』には0以上の整数を指定してください。指定値=『{OPT['limit']}』」で戻る。
    ここまで。
    「」で戻る。
ここまで。

#-------------------------------------------------
# 命令一覧の読み込み
#-------------------------------------------------
# doc/command_list.jsonを読み込んで検索しやすい形に整えて返す
●命令一覧取得()
    もし、(命令ファイルが存在)=偽ならば
        「[エラー] 命令一覧が見つかりません: {命令ファイル}」を表示。
        「先に『npm run build:command』を実行してください。」を表示。
        []で戻る。
    ここまで。
    LIST＝[]
    エラー監視
        S＝命令ファイルを開く。
        RAW＝SをJSONデコード。
        RAWを反復
            C＝対象。
            D＝空辞書。
            D['type']＝「{C['type']}」
            D['name']＝「{C['name']}」
            D['args']＝「{C['args']}」
            D['yomi']＝「{C['yomi']}」
            D['plugin']＝「{C['plugin']}」
            D['group']＝「{C['group']}」
            D['target']＝C['target']
            D['description']＝「」
            もし、(C['description']の変数型確認)=「string」ならば
                D['description']＝C['description']
            ここまで。
            D['name_lc']＝D['name']を小文字変換。
            D['text_lc']＝「{D['name']} {D['yomi']} {D['description']}」を小文字変換。
            LISTにDを配列追加。
        ここまで。
    エラーならば
        「[エラー] 命令一覧を読み込めません: {エラーメッセージ}」を表示。
        []で戻る。
    ここまで。
    LISTで戻る。
ここまで。

#-------------------------------------------------
# 検索と絞り込み
#-------------------------------------------------
# 命令Cが絞り込み条件OPTに合うかを返す
●条件一致(CがOPTに)
    T＝OPT['target']
    もし、T≠「」ならば
        TS＝C['target']を「,」で配列結合。
        IDX＝「,{TS},」で「,{T},」が何文字目か。
        もし、IDX=0ならば、偽で戻る。
    ここまで。
    G＝OPT['group']
    もし、G≠「」ならば
        G2＝Gのグループ正規化。
        もし、C['group']≠G2ならば、偽で戻る。
    ここまで。
    P＝OPT['plugin']
    もし、P≠「」ならば
        IDX2＝(C['plugin']を小文字変換)で(Pを小文字変換)が何文字目か。
        もし、IDX2=0ならば、偽で戻る。
    ここまで。
    TY＝OPT['type']
    もし、TY≠「」ならば
        もし、C['type']≠TYならば、偽で戻る。
    ここまで。
    真で戻る。
ここまで。

# 命令Cが検索語WORDSをすべて含むかを返す
●語一致(CがWORDSに)
    HAY＝C['text_lc']
    WORDSを反復
        W＝(「{対象}」のトリム)を小文字変換。
        もし、W≠「」ならば
            IDX＝HAYでWが何文字目か。
            もし、IDX=0ならば、偽で戻る。
        ここまで。
    ここまで。
    真で戻る。
ここまで。

# 命令の一覧を検索して並び替えた配列を返す
●命令検索(LISTをOPTで)
    WORDS＝OPT['words']
    B0＝[]
    B1＝[]
    B2＝[]
    B3＝[]
    W＝「」
    もし、(WORDSの要素数)>0ならば
        W＝(「{WORDS[0]}」のトリム)を小文字変換。
    ここまで。
    LISTを反復
        C＝対象。
        合致＝オン。
        もし、(CがOPTに条件一致)=偽ならば、合致＝オフ。
        もし、(合致=オン)かつ((CがWORDSに語一致)=偽)ならば、合致＝オフ。
        もし、合致＝オンならば
            NM＝C['name_lc']
            もし、W=「」ならば
                B3にCを配列追加。
            違えば
                もし、NM=Wならば
                    B0にCを配列追加。
                違えば
                    もし、NMがWで文字始ならば
                        B1にCを配列追加。
                    違えば
                        IDX＝NMでWが何文字目か。
                        もし、IDX>0ならば
                            B2にCを配列追加。
                        違えば
                            B3にCを配列追加。
                        ここまで。
                    ここまで。
                ここまで。
            ここまで。
        ここまで。
    ここまで。
    R＝[]
    B0を反復、Rに対象を配列追加。
    B1を反復、Rに対象を配列追加。
    B2を反復、Rに対象を配列追加。
    B3を反復、Rに対象を配列追加。
    Rで戻る。
ここまで。

#-------------------------------------------------
# 出力
#-------------------------------------------------
# 使い方を表示する
●ヘルプ表示()
    「なでしこ3 命令検索CLI - doc/command_list.jsonから命令を検索します」を表示。
    「」を表示。
    「使い方: npm run search:command -- [検索語...] [オプション]」を表示。
    「        node batch/search_command.mjs [検索語...] [オプション]」を表示。
    「」を表示。
    「検索語は命令名・読み方・説明から部分一致で検索します(複数指定するとAND条件)。」を表示。
    「」を表示。
    「オプション:」を表示。
    「  --target <名前>   実行環境で絞り込む (cnako/wnako/phpnako/enako)」を表示。
    「  --group <名前>    種別で絞り込む (basic=基本プラグイン, extra=拡張プラグイン)」を表示。
    「  --plugin <名前>   プラグイン名で絞り込む (部分一致) 例: plugin_node」を表示。
    「  --type <種類>     命令の種類で絞り込む (関数/変数/定数)」を表示。
    「  --limit <件数>    表示する最大件数 (既定値=50、0で無制限)」を表示。
    「  --json            JSON形式で出力する」を表示。
    「  --help, -h        この使い方を表示する」を表示。
    「」を表示。
    「例:」を表示。
    「  npm run search:command -- ファイル --target cnako」を表示。
    「  npm run search:command -- DOM --target wnako --group basic」を表示。
    「  npm run search:command -- CSV --json」を表示。
    「」を表示。
    「終了コード: 0=見つかった / 1=一致なし / 2=引数エラー / 3=読み込みエラー」を表示。
ここまで。

# 命令Cを2行で表示する
●命令表示(Cを)
    S＝「[{C['type']}] {C['name']}」
    もし、C['args']≠「」ならば
        S＝「{S} ({C['args']})」
    ここまで。
    TS＝C['target']を「,」で配列結合。
    S＝「{S}  {C['plugin']} <{TS}>」
    Sを表示。
    もし、C['description']≠「」ならば
        「    {C['description']}」を表示。
    ここまで。
ここまで。

# 検索条件を人が読める文字列にする
●検索条件文字列(OPTを)
    WORDS＝OPT['words']
    S＝「(すべての命令)」
    もし、(WORDSの要素数)>0ならば
        WS＝WORDSを「 」で配列結合。
        S＝「『{WS}』」
    ここまで。
    JOKEN＝[]
    もし、OPT['target']≠「」ならば、JOKENに「target={OPT['target']}」を配列追加。
    もし、OPT['group']≠「」ならば
        GN＝OPT['group']のグループ正規化。
        JOKENに「group={GN}」を配列追加。
    ここまで。
    もし、OPT['plugin']≠「」ならば、JOKENに「plugin={OPT['plugin']}」を配列追加。
    もし、OPT['type']≠「」ならば、JOKENに「type={OPT['type']}」を配列追加。
    もし、(JOKENの要素数)>0ならば
        JS＝JOKENを「, 」で配列結合。
        S＝「{S} ({JS})」
    ここまで。
    Sで戻る。
ここまで。

# 検索結果を通常の形式で表示する
●結果表示(RESULTをOPTで)
    「検索: {OPTを検索条件文字列}」を表示。
    CNT＝RESULTの要素数。
    もし、CNT=0ならば
        「一致する命令は見つかりませんでした。」を表示。
        戻る。
    ここまで。
    「{CNT}件見つかりました。」を表示。
    「」を表示。
    LIMIT＝OPT['limit']を整数変換。
    もし、LIMIT=0ならば、LIMIT＝CNT。
    I＝0
    RESULTを反復
        もし、I>=LIMITならば、抜ける。
        対象を命令表示。
        I＝I+1
    ここまで。
    もし、CNT>LIMITならば
        NOKORI＝CNT-LIMIT
        「」を表示。
        「... 他 {NOKORI}件（すべて表示するには --limit 0 を指定してください）」を表示。
    ここまで。
ここまで。

# 検索結果をJSON形式で表示する
●結果JSON表示(RESULTをOPTで)
    LIMIT＝OPT['limit']を整数変換。
    CNT＝RESULTの要素数。
    もし、LIMIT=0ならば、LIMIT＝CNT。
    OUT＝[]
    I＝0
    RESULTを反復
        もし、I>=LIMITならば、抜ける。
        C＝対象。
        D＝空辞書。
        D['type']＝C['type']
        D['name']＝C['name']
        D['args']＝C['args']
        D['yomi']＝C['yomi']
        D['description']＝C['description']
        D['plugin']＝C['plugin']
        D['group']＝C['group']
        D['target']＝C['target']
        OUTにDを配列追加。
        I＝I+1
    ここまで。
    OUTをJSONエンコード整形して表示。
ここまで。

#-------------------------------------------------
# メイン処理(戻り値は終了コード)
#-------------------------------------------------
●メイン処理()
    ARGS＝コマンド引数取得()
    OPT＝ARGSを引数解析。
    # ヘルプの表示
    もし、OPT['help']＝オンならば
        ヘルプ表示。
        0で戻る。
    ここまで。
    # 引数のエラー
    もし、OPT['error']≠「」ならば
        「[エラー] {OPT['error']}」を表示。
        「」を表示。
        ヘルプ表示。
        2で戻る。
    ここまで。
    EMSG＝OPTをオプション検査。
    もし、EMSG≠「」ならば
        「[エラー] {EMSG}」を表示。
        2で戻る。
    ここまで。
    # 検索語も絞り込みもないなら使い方を表示
    ジョウケン数＝(OPT['words']の要素数)
    もし、OPT['target']≠「」ならば、ジョウケン数＝ジョウケン数+1。
    もし、OPT['group']≠「」ならば、ジョウケン数＝ジョウケン数+1。
    もし、OPT['plugin']≠「」ならば、ジョウケン数＝ジョウケン数+1。
    もし、OPT['type']≠「」ならば、ジョウケン数＝ジョウケン数+1。
    もし、ジョウケン数=0ならば
        ヘルプ表示。
        2で戻る。
    ここまで。
    # 命令一覧を読み込む
    LIST＝命令一覧取得()
    もし、(LISTの要素数)=0ならば、3で戻る。
    # 検索する
    RESULT＝LISTをOPTで命令検索。
    もし、OPT['json']＝オンならば
        RESULTをOPTで結果JSON表示。
    違えば
        RESULTをOPTで結果表示。
    ここまで。
    もし、(RESULTの要素数)=0ならば、1で戻る。
    0で戻る。
ここまで。

終了コード＝メイン処理()
「process.exitCode={終了コード}」をJS実行。
